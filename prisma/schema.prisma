// =====================================================================
// SubFlow（字幕工坊）- 数据库 Schema
// 产品：AI 短视频字幕工具（上传视频 → ASR 转写 → LLM 润色 → 样式模板 → 导出）
// 数据库：PostgreSQL 16（本地 Docker：subflow-db 容器）
// 说明：
//   - 时长类额度统一以「秒」为单位存储，避免浮点精度问题
//   - segments 使用 Json 类型存储转写分段：[{ start, end, text, keywords[] }]
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// 用户：手机号登录，balanceSeconds 为剩余可用转写额度（秒）
// ---------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  phone         String   @unique // 手机号（国内登录主键）
  nickname      String?
  balanceSeconds Int     @default(0) // 剩余额度（秒），注册赠送 + 购买/兑换累加
  inviteCode    String?  @unique // 我的邀请码（懒生成，8 位无混淆字符，P2.5）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects      Project[]
  subscriptions Subscription[]
  orders        Order[]
  creditLedger  CreditLedger[]
  sessions      Session[]
  notifications Notification[]
  userStyles    UserStyle[]
  invitesSent   InviteRecord[]  @relation("inviter") // 我邀请过的人
  inviteReceived InviteRecord?  @relation("invitee") // 邀请我的人（一人最多被邀请一次）
}

// ---------------------------------------------------------------------
// 邀请记录（P2.5 邀请裂变）：新用户注册时携带邀请码 → 双方得额度；
// inviteeId unique 保证一个账号只能被邀请一次（防重复刷奖）
// ---------------------------------------------------------------------
model InviteRecord {
  id              String   @id @default(cuid())
  inviterId       String // 邀请人
  inviteeId       String   @unique // 被邀请人（新注册用户）
  bonusInviterSec Int // 邀请人获得的奖励（秒，快照）
  bonusInviteeSec Int // 被邀请人额外获得的奖励（秒，快照）
  createdAt       DateTime @default(now())

  inviter User @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId, createdAt])
}

// ---------------------------------------------------------------------
// 套餐：月订阅计划（价格以「分」为单位存储，避免浮点误差）
// ---------------------------------------------------------------------
model Plan {
  id             String  @id @default(cuid())
  name           String // 套餐名，如「基础版」「专业版」
  priceCents     Int // 月价（人民币分）
  monthlySeconds Int // 每月包含的转写秒数
  description    String?
  isActive       Boolean @default(true) // 是否在售

  subscriptions Subscription[]
  orders        Order[]
}

// ---------------------------------------------------------------------
// 订阅记录：一个用户同一时间可有多条历史记录，以 expireAt 判断有效性
// ---------------------------------------------------------------------
model Subscription {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  startAt   DateTime
  expireAt  DateTime
  status    SubStatus @default(ACTIVE)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

// ---------------------------------------------------------------------
// 订单：MVP 阶段走激活码（REDEEM）与手动开通（MANUAL），后续接微信支付（WX_NATIVE）
// ---------------------------------------------------------------------
model Order {
  id              String       @id @default(cuid())
  userId          String
  planId          String? // 关联套餐（赠送类订单可为空）
  amountCents     Int          @default(0) // 实付金额（分），0 = 免费/兑换
  status          OrderStatus  @default(PENDING)
  channel         OrderChannel @default(MANUAL)
  wxTransactionId String?      @unique // 微信支付交易号（预留）
  paidAt          DateTime?
  createdAt       DateTime     @default(now())

  user User  @relation(fields: [userId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------
// 额度流水：所有 balanceSeconds 的变动必须留痕（赠送/消耗/兑换/管理员调整）
// ---------------------------------------------------------------------
model CreditLedger {
  id            String   @id @default(cuid())
  userId        String
  changeSeconds Int // 正数=增加，负数=消耗
  balanceAfter  Int // 变动后的余额快照
  reason        String // SIGNUP_BONUS / CONSUME_TRANSCRIBE / REDEEM / ADMIN_ADJUST ...
  refId         String? // 关联业务 ID（如 projectId / orderId）
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------
// 视频项目：核心业务实体，status 描述流水线阶段
// ---------------------------------------------------------------------
model Project {
  id          String        @id @default(cuid())
  userId      String
  title       String // 默认取文件名
  status      ProjectStatus @default(UPLOADED)
  mediaKind   String        @default("video") // 媒体类型：video（视频）/ audio（纯音频，P2.1 音频直传）
  videoKey    String? // 对象存储 key（生产：COS/OSS；本地：uploads/ 相对路径；音频也存此字段，历史命名）
  videoName   String? // 原始文件名
  durationSec Float? // 媒体时长（秒），由 FFmpeg 探测
  error       String? // 流水线失败原因（status=FAILED 时展示给用户）
  language    String        @default("zh")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id])
  transcript  Transcript?
  exportTasks ExportTask[]
  translations Translation[]

  @@index([userId, updatedAt])
}

// ---------------------------------------------------------------------
// 转写结果：与项目一对一；segments 为润色后的分段（含关键词高亮标记）
// ---------------------------------------------------------------------
model Transcript {
  id          String   @id @default(cuid())
  projectId   String   @unique
  segments    Json // [{ start, end, text, keywords: ["xxx"] }]
  rawText     String? // ASR 原始全文（润色前留底）
  asrProvider String? // 使用的 ASR 服务标识（paraformer / local-whisper ...）
  llmPolished Boolean  @default(false) // 是否已经过 LLM 润色
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------
// 字幕样式模板：config 存 JSONB 样式配置（字体/颜色/描边/位置/高亮色等）
// ---------------------------------------------------------------------
model Style {
  id        String   @id @default(cuid())
  name      String
  config    Json // 样式配置，结构与前端渲染器和 FFmpeg ASS 生成器约定一致
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  exportTasks ExportTask[]
}

// ---------------------------------------------------------------------
// 用户自定义样式模板（P2.2）：config 与全局 Style.config 同契约，
// 仅归属用户本人可见/可用；上限条数在 API 层控制（≤20 条/用户）
// ---------------------------------------------------------------------
model UserStyle {
  id        String   @id @default(cuid())
  userId    String
  name      String // 模板名（用户自定义，1-20 字符）
  config    Json // 样式配置（契约同 Style.config）
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------
// 导出任务：FFmpeg 烧录字幕为异步任务
// ---------------------------------------------------------------------
model ExportTask {
  id          String     @id @default(cuid())
  projectId   String
  styleId     String?
  styleConfig Json? // 创建任务时的样式快照（烧录以此为准；官方/个人模板后续被删改不影响本任务）
  resolution  String     @default("720p")
  // 片段导出（P2.6）：起止秒（可空 = 整片导出）；音频项目片段为纯裁剪（无样式语义）
  startSec    Float?
  endSec      Float?
  status      TaskStatus @default(PENDING)
  outputKey   String? // 导出产物的存储 key
  error       String? // 失败原因
  createdAt   DateTime   @default(now())
  finishedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  style   Style?  @relation(fields: [styleId], references: [id])

  @@index([projectId])
}

// ---------------------------------------------------------------------
// 字幕翻译任务（P2.4）：LLM 批量翻译整项目字幕为目标语言；
// segments 为翻译后分段（时间不变、text 为译文、keywords 不保留）；
// 同项目同语言仅一个版本（unique 约束，重新翻译覆盖旧行）
// ---------------------------------------------------------------------
model Translation {
  id          String     @id @default(cuid())
  projectId   String
  targetLang  String // 目标语言代码（见 constants.ts TRANSLATE_LANGUAGES）
  status      TaskStatus @default(PENDING)
  segments    Json? // 翻译后分段 [{ start, end, text }]（完成时写入）
  charCount   Int? // 源字幕总字符数（计费依据快照）
  costSeconds Int? // 实际扣减额度（秒，成功后回填）
  error       String? // 失败原因
  createdAt   DateTime   @default(now())
  finishedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, targetLang])
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------
// 激活码：MVP 无支付资质阶段的收款载体（手动收款 → 发码 → 用户兑换）
// ---------------------------------------------------------------------
model RedeemCode {
  id           String     @id @default(cuid())
  code         String     @unique // 激活码本体（生成时保证唯一性）
  planId       String? // 兑换后开通的套餐（二选一：套餐 or 直接送时长）
  bonusSeconds Int? // 直接赠送的额度秒数
  status       CodeStatus @default(UNUSED)
  usedBy       String? // 兑换用户 ID
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------
// 短信验证码：独立于用户表（未注册手机号也要能收码）；codeHash 存 SHA-256 哈希
// ---------------------------------------------------------------------
model SmsVerification {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String // SHA-256(验证码)，不存明文
  expiresAt DateTime // 有效期 5 分钟
  consumed  Boolean  @default(false) // 登录成功后置 true，防重放
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// ---------------------------------------------------------------------
// 登录会话：随机 token 存库 + httpOnly Cookie，可随时吊销（登出/踢下线）
// ---------------------------------------------------------------------
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // SHA-256(session token)
  expiresAt DateTime // 30 天有效期
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------
// 站内通知：转写/导出完成与失败提醒（P1.3），铃铛未读数 + 列表
// ---------------------------------------------------------------------
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // TRANSCRIBE_DONE / TRANSCRIBE_FAILED / EXPORT_DONE / EXPORT_FAILED
  title     String
  body      String?
  link      String? // 点击跳转路径（如 /project/xxx）
  readAt    DateTime? // 已读时间（null = 未读）
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ----------------------------- 枚举定义 -----------------------------

/// 项目状态机：UPLOADED → TRANSCRIBING → POLISHING → READY / FAILED
enum ProjectStatus {
  UPLOADED
  TRANSCRIBING
  POLISHING
  READY
  FAILED
}

/// 通用异步任务状态（导出任务用）
enum TaskStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// 订单状态
enum OrderStatus {
  PENDING
  PAID
  CLOSED
  REFUNDED
}

/// 支付渠道：MANUAL=手动开通，WX_NATIVE=微信扫码（预留），REDEEM=激活码兑换
enum OrderChannel {
  MANUAL
  WX_NATIVE
  REDEEM
}

/// 订阅状态
enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// 激活码状态
enum CodeStatus {
  UNUSED
  USED
  DISABLED
}
