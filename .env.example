# =====================================================================
# SubFlow 环境变量模板：复制为 .env 后填写生产值（本地开发同理）
# .env 已被 .gitignore 忽略，绝不提交真实密钥
# =====================================================================

# PostgreSQL（本地开发示例：postgresql://postgres:subflow123@localhost:5432/subflow?schema=public）
# docker compose 部署时：只需配置 POSTGRES_PASSWORD，连接串由 compose 自动拼接
DATABASE_URL=""
# docker compose 部署用：数据库 root 密码
POSTGRES_PASSWORD=""

# 阿里云百炼 DashScope API Key（Qwen ASR + LLM 润色），https://bailian.aliyun.com
# 注意：上线前必须轮换 Key（开发期间曾暴露）
# 仅作为未配置 AI 网关时的直连回落；推荐生产配置下方 AI_GATEWAY_* 走网关
DASHSCOPE_API_KEY=""

# ---------------------------------------------------------------------
# AI 网关（new-api 自托管，多上游渠道优先级路由 + 失败自动切换）。
#   配置后润色/翻译/OCR/同步 ASR 的 chat 调用全部走网关：主渠道（DashScope）
#   额度耗尽或故障时网关自动切换备用渠道（火山方舟等），用户无感知；
#   不配置则回落上方 DASHSCOPE_API_KEY 直连（渐进式迁移，可随时回滚）。
#   AI_GATEWAY_BASE_URL 形如 http://127.0.0.1:3001/v1（new-api 默认端口 3000，
#   与本服务冲突，容器映射为 3001）；AI_GATEWAY_API_KEY 是 new-api 控制台
#   签发的令牌（sk- 开头），不是任何上游渠道的 Key。
#   部署与渠道配置见 docs/AI-GATEWAY.md。ASR 异步文件转写（qwen-filetrans）
#   为 DashScope 专有 API，不走网关，始终直连。
# ---------------------------------------------------------------------
AI_GATEWAY_BASE_URL=""
AI_GATEWAY_API_KEY=""

# ---------------------------------------------------------------------
# 短信：生产必须先在阿里云报备签名+模板，再关闭开发模式
# ---------------------------------------------------------------------
SMS_DEV_MODE="false"
DEV_FIXED_CODE=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""

# ---------------------------------------------------------------------
# ASR 模式：生产用 qwen-filetrans（原生毫秒时间戳）。
#   STORAGE_DRIVER=oss 时：源视频存 OSS，服务端自动签发 12 小时私有读 URL
#   传给 DashScope 拉取，无需 PUBLIC_ASSET_BASE_URL。
#   STORAGE_DRIVER=local 时：必须配置 PUBLIC_ASSET_BASE_URL 为站点公网地址
#   （如 https://yourdomain.com），DashScope 会主动下载 {地址}/{videoKey}。
# ---------------------------------------------------------------------
ASR_PROVIDER="qwen-filetrans"
PUBLIC_ASSET_BASE_URL=""

# 注册赠送额度（秒）
SIGNUP_BONUS_SECONDS="1800"

# 管理后台白名单（逗号分隔完整手机号），配置后白名单用户可访问 /admin 发激活码
ADMIN_PHONES=""

# ---------------------------------------------------------------------
# 任务队列（Redis/BullMQ）：compose 部署时由 redis 服务自动拼内网地址，
# 单机裸跑 Next 时填宿主机地址（如 redis://localhost:6379）
# ---------------------------------------------------------------------
REDIS_URL="redis://redis:6379"
# Worker 并发上限：转写（IO 密集，建议 2-4）/ 导出（FFmpeg 吃 CPU，建议 1-2）
TRANSCRIBE_CONCURRENCY="3"
EXPORT_CONCURRENCY="1"
# 进程内 Worker（本地裸跑 Next 免开第二个终端时设 1）。
# compose 部署用独立 worker 容器，此处务必留空——否则 Web 容器内也会跑 FFmpeg 抢 CPU。
ENABLE_INPROCESS_WORKER=""

# ICP 备案号（备案通过后填写，如 "京ICP备2026000000号-1"；页脚自动展示并链至工信部，留空不显示）
NEXT_PUBLIC_ICP_BEIAN=""

# ---------------------------------------------------------------------
# 告警通知（P1.6 可观测性）：钉钉群自定义机器人 webhook
# 触发：转写/导出任务重试用尽失败、额度守卫拦截、进程未捕获异常
# 创建方法：钉钉建群 → 群设置 → 机器人 → 添加「自定义」机器人 →
#           安全设置选「加签」，把 Webhook 与加签密钥（SEC 开头）填到下面
# 留空则只落结构化日志，不影响运行
# ---------------------------------------------------------------------
ALERT_DINGTALK_WEBHOOK=""
ALERT_DINGTALK_SECRET=""
# 同类告警冷却秒数（限频防骚扰，默认 300）
ALERT_COOLDOWN_SECONDS="300"

# ---------------------------------------------------------------------
# 对象存储（P1.2）：视频直传阿里云 OSS，浏览器分片直传不经服务器带宽
#   STORAGE_DRIVER=local  纯本地盘（传统模式）
#   STORAGE_DRIVER=oss    视频直传 OSS（推荐生产）：转写/导出时 worker 拉取，
#                         预览与成片下载 302 到签名 URL
# 首次部署后执行一次：npx tsx scripts/setup-oss-cors.ts（配置浏览器直传所需 CORS）
# RAM 子用户最小权限：oss:PutObject/GetObject/DeleteObject/AbortMultipartUpload/
#                    ListParts/InitiateMultipartUpload/CompleteMultipartUpload/
#                    PutBucketCors/GetBucketCors（限目标 Bucket）
# ---------------------------------------------------------------------
STORAGE_DRIVER="local"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
OSS_REGION="oss-cn-hangzhou"
# 生产 ECS 与 OSS 同地域时填内网 endpoint（如 oss-cn-hangzhou-internal.aliyuncs.com，
# 内网传输免流量费）；留空用公网 endpoint
OSS_INTERNAL_ENDPOINT=""
# CDN 下载域名（备案后绑定；留空则预览/下载用服务端签发的 OSS 签名 URL）
OSS_PUBLIC_BASE=""
