# =====================================================================
# SubFlow 环境变量模板：复制为 .env 后填写生产值（本地开发同理）
# .env 已被 .gitignore 忽略，绝不提交真实密钥
# =====================================================================

# PostgreSQL（本地开发示例：postgresql://postgres:subflow123@localhost:5432/subflow?schema=public）
# docker compose 部署时：只需配置 POSTGRES_PASSWORD，连接串由 compose 自动拼接
DATABASE_URL=""
# docker compose 部署用：数据库 root 密码
POSTGRES_PASSWORD=""

# 阿里云百炼 DashScope API Key（Qwen ASR + LLM 润色），https://bailian.aliyun.com
# 注意：上线前必须轮换 Key（开发期间曾暴露）
DASHSCOPE_API_KEY=""

# ---------------------------------------------------------------------
# 短信：生产必须先在阿里云报备签名+模板，再关闭开发模式
# ---------------------------------------------------------------------
SMS_DEV_MODE="false"
DEV_FIXED_CODE=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""

# ---------------------------------------------------------------------
# ASR 模式：生产用 qwen-filetrans（原生毫秒时间戳），
# 需配置 PUBLIC_ASSET_BASE_URL 为站点公网地址（如 https://yourdomain.com），
# DashScope 会主动下载 {PUBLIC_ASSET_BASE_URL}/{videoKey} 拉取音频
# ---------------------------------------------------------------------
ASR_PROVIDER="qwen-filetrans"
PUBLIC_ASSET_BASE_URL=""

# 注册赠送额度（秒）
SIGNUP_BONUS_SECONDS="1800"

# 管理后台白名单（逗号分隔完整手机号），配置后白名单用户可访问 /admin 发激活码
ADMIN_PHONES=""

# ---------------------------------------------------------------------
# 任务队列（Redis/BullMQ）：compose 部署时由 redis 服务自动拼内网地址，
# 单机裸跑 Next 时填宿主机地址（如 redis://localhost:6379）
# ---------------------------------------------------------------------
REDIS_URL="redis://redis:6379"
# Worker 并发上限：转写（IO 密集，建议 2-4）/ 导出（FFmpeg 吃 CPU，建议 1-2）
TRANSCRIBE_CONCURRENCY="3"
EXPORT_CONCURRENCY="1"
# 进程内 Worker（本地裸跑 Next 免开第二个终端时设 1）。
# compose 部署用独立 worker 容器，此处务必留空——否则 Web 容器内也会跑 FFmpeg 抢 CPU。
ENABLE_INPROCESS_WORKER=""

# ICP 备案号（备案通过后填写，如 "京ICP备2026000000号-1"；页脚自动展示并链至工信部，留空不显示）
NEXT_PUBLIC_ICP_BEIAN=""
